# Copy to .env on the VM; never commit the real file. Use URL-safe random passwords.
SITE_DOMAIN=barter.example.ru
POSTGRES_PASSWORD=replace-with-long-url-safe-random-value
DATABASE_URL=postgresql://barter:replace-with-long-url-safe-random-value@postgres:5432/barter?schema=public
JWT_SECRET=replace-with-a-different-long-random-value
MEILI_MASTER_KEY=replace-with-another-long-random-value
