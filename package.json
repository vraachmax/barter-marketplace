{
  "name": "barter-clone",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\\\npm.ps1 run -w @app/web dev",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\\\npm.ps1 run -w @app/api start:dev",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\\\free-dev-ports.ps1 && concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\\\npm.ps1 --workspaces run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "http-proxy": "^1.18.1"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.15"
  },
  "overrides": {
    "@nestjs/cli": {
      "@angular-devkit/core": "19.2.24",
      "@angular-devkit/schematics": "19.2.24",
      "@angular-devkit/schematics-cli": "19.2.24"
    },
    "engine.io": "6.6.7",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.0"
  }
}
